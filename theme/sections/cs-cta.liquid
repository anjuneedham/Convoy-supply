{%- comment -%} ConvoySupply — closing CTA band. Copy: store/homepage-copy.md §14 {%- endcomment -%}
<section class="cs-section cs-cta-band {% if section.settings.dark %}cs-section--dark{% else %}cs-section--light{% endif %}"
  {%- if section.settings.image != blank %} style="background-image:linear-gradient(rgba(28,31,33,.72),rgba(28,31,33,.72)),url({{ section.settings.image | image_url: width: 1600 }});background-size:cover;background-position:center;color:var(--cs-concrete)"{% endif -%}>
  <div class="cs-wrap cs-cta-band__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="cs-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}<div class="cs-body cs-lede">{{ section.settings.body }}</div>{%- endif -%}
    <div>
      {%- if section.settings.cta_label != blank -%}
        <a class="cs-btn cs-btn--primary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="cs-btn cs-btn--ghost" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.microcopy != blank -%}<p class="cs-micro">{{ section.settings.microcopy }}</p>{%- endif -%}
  </div>
</section>

<style>
  .cs-cta-band { padding: 88px 0; }
  .cs-cta-band__inner { max-width: 760px; }
  @media (max-width: 599px) { .cs-cta-band { padding: 56px 0; } }
</style>

{% schema %}
{
  "name": "CS CTA band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Squared away." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Four pieces. One sorted cab. Nothing drilled, nothing bolted, nothing modified.</p>" },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Get the Cab Reset Kit — $89" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Start with the CS-01 — $54.99" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA link" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Free US shipping over $75 · 30-day returns · A real person answers support@" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "checkbox", "id": "dark", "label": "Dark background (when no image)", "default": true }
  ],
  "presets": [{ "name": "CS CTA band" }]
}
{% endschema %}
