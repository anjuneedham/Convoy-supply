{%- comment -%}
  ConvoySupply — honest comparison table. Copy: store/homepage-copy.md §8
  Rule: every claim in this table must be defensible. The "no reviews yet" row stays.
{%- endcomment -%}
<section class="cs-section cs-section--paper">
  <div class="cs-wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="cs-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.body != blank -%}<div class="cs-body cs-lede">{{ section.settings.body }}</div>{%- endif -%}

    <div class="cs-compare__scroll">
      <table class="cs-table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col0 }}</th>
            <th scope="col">{{ section.settings.col1 }}</th>
            <th scope="col">{{ section.settings.col2 }}</th>
            <th scope="col" class="cs-col-us">{{ section.settings.col3 }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label }}</th>
              <td>{{ block.settings.v1 }}</td>
              <td>{{ block.settings.v2 }}</td>
              <td class="cs-col-us">{{ block.settings.v3 }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="cs-micro">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-compare__scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 28px; }
  .cs-compare__scroll .cs-table { min-width: 640px; }
</style>

{% schema %}
{
  "name": "CS Comparison",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the cab, not the catalog" },
    { "type": "richtext", "id": "body", "label": "Intro copy" },
    { "type": "text", "id": "col0", "label": "Column 0 header", "default": " " },
    { "type": "text", "id": "col1", "label": "Column 1 header", "default": "Generic marketplace organizers" },
    { "type": "text", "id": "col2", "label": "Column 2 header", "default": "Specialty truck retail" },
    { "type": "text", "id": "col3", "label": "Column 3 header (us)", "default": "ConvoySupply" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Specialty retail pricing observed at approximately $75.99 for comparable cab organizers." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Designed for" },
        { "type": "text", "id": "v1", "label": "Column 1 value" },
        { "type": "text", "id": "v2", "label": "Column 2 value" },
        { "type": "text", "id": "v3", "label": "Column 3 value (us)" }
      ]
    }
  ],
  "presets": [{ "name": "CS Comparison", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
