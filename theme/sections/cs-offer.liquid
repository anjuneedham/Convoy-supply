{%- comment -%}
  ConvoySupply — offer section for the CS-01 landing page. Copy: store/landing-page.md §8

  Two options only. Each posts directly to /cart/add so a cold visitor
  converts without an intermediate page.

  Compare-at values must be the genuine sum of real individual prices.
  No inflated "was" pricing. See brand/brand-copy.md compliance rule 3.
{%- endcomment -%}
<section class="cs-section cs-section--light" id="offer">
  <div class="cs-wrap">
    <h2 class="cs-h2">{{ section.settings.heading }}</h2>

    <div class="cs-grid cs-grid--2" style="margin-top:32px">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <div class="cs-card cs-offer{% if block.settings.flag != blank %} cs-offer--flagged{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.flag != blank -%}<p class="cs-offer__flag">{{ block.settings.flag }}</p>{%- endif -%}
          <h3 class="cs-h3">{{ block.settings.title }}</h3>
          {%- if block.settings.contents != blank -%}<div class="cs-body cs-offer__contents">{{ block.settings.contents }}</div>{%- endif -%}

          {%- if p != blank -%}
            <p class="cs-offer__price">
              {%- if p.compare_at_price > p.price -%}
                <s class="cs-offer__was">{{ p.compare_at_price | money }}</s>
                <strong>{{ p.price | money }}</strong>
                <span class="cs-offer__save">Save {{ p.compare_at_price | minus: p.price | money }}</span>
              {%- else -%}
                <strong>{{ p.price | money }}</strong>
              {%- endif -%}
            </p>

            {%- if p.available -%}
              {% form 'product', p %}
                <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                <button type="submit" class="cs-btn cs-btn--primary cs-offer__btn">{{ block.settings.cta_label }}</button>
              {% endform %}
            {%- else -%}
              <p class="cs-offer__oos">Out of stock. Email us and we'll tell you when it's back.</p>
            {%- endif -%}
          {%- else -%}
            <p class="cs-micro">Select a product in the theme editor.</p>
          {%- endif -%}

          {%- if block.settings.note != blank -%}<p class="cs-micro">{{ block.settings.note }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.honesty_note != blank -%}
      <div class="cs-note" style="margin-top:28px">{{ section.settings.honesty_note }}</div>
    {%- endif -%}
    {%- if section.settings.shipping_note != blank -%}
      <div class="cs-body" style="margin-top:20px">{{ section.settings.shipping_note }}</div>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-offer { display: flex; flex-direction: column; }
  .cs-offer--flagged { border-color: var(--cs-hiviz); border-width: 2px; }
  .cs-offer__flag {
    font-family: var(--cs-font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    background: var(--cs-hiviz); color: var(--cs-asphalt); display: inline-block;
    padding: 4px 10px; border-radius: var(--cs-radius); margin: 0 0 12px; align-self: flex-start;
  }
  .cs-offer__contents { margin-bottom: 16px; }
  .cs-offer__price { font-family: var(--cs-font-mono); font-size: 1.15rem; margin: auto 0 16px; }
  .cs-offer__price strong { font-size: 1.6rem; }
  .cs-offer__was { color: var(--cs-mute); margin-right: 8px; }
  .cs-offer__save { display: inline-block; margin-left: 10px; color: var(--cs-good); font-weight: 600; }
  .cs-offer__btn { width: 100%; }
  .cs-offer__oos { color: var(--cs-warn); font-weight: 600; }
</style>

{% schema %}
{
  "name": "CS Offer",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The offer" },
    { "type": "richtext", "id": "honesty_note", "label": "Pricing honesty note", "default": "<p>The saving is the real difference between the kit price and the three individual prices, which are what we actually charge for them. We don't mark anything up to discount it.</p>" },
    { "type": "richtext", "id": "shipping_note", "label": "Shipping note" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Offer option",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Option title", "default": "CS-01 alone" },
        { "type": "richtext", "id": "contents", "label": "What's in it" },
        { "type": "text", "id": "flag", "label": "Flag (e.g. 'Most complete') — leave blank for none" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart" },
        { "type": "text", "id": "note", "label": "Note under button", "default": "Free shipping over $75 · 30-day returns" }
      ]
    }
  ],
  "presets": [{ "name": "CS Offer", "blocks": [{ "type": "option" }, { "type": "option" }] }]
}
{% endschema %}
