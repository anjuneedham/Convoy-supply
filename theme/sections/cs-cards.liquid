{%- comment -%}
  ConvoySupply — generic card grid.
  Reused for: the problem section, benefits, how-it-works steps.
  Copy: store/homepage-copy.md §4, §6, §10
{%- endcomment -%}
<section class="cs-section {% if section.settings.dark %}cs-section--dark{% else %}cs-section--light{% endif %}">
  <div class="cs-wrap">
    {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="cs-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="cs-body cs-lede">{{ section.settings.body }}</div>{%- endif -%}

    <div class="cs-grid cs-grid--{{ section.settings.columns }}" style="margin-top:36px">
      {%- for block in section.blocks -%}
        <div class="cs-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
               | image_url: width: 800
               | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 100vw', widths: '400,600,800', alt: block.settings.image_alt }}
          {%- endif -%}
          {%- if section.settings.numbered -%}
            <p class="cs-eyebrow cs-card__num">{{ forloop.index }}</p>
          {%- endif -%}
          <h3 class="cs-h3">{{ block.settings.title }}</h3>
          <div class="cs-body">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.callout != blank -%}
      <div class="cs-note" style="margin-top:32px">{{ section.settings.callout }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <p style="margin-top:32px"><a class="cs-btn cs-btn--primary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a></p>
    {%- endif -%}
  </div>
</section>

<style>
  .cs-card__num { font-size: 1.6rem; font-weight: 700; margin-bottom: 4px; }
</style>

{% schema %}
{
  "name": "CS Card grid",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What actually changes" },
    { "type": "richtext", "id": "body", "label": "Intro copy" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "numbered", "label": "Number the cards (for step sequences)", "default": false },
    { "type": "richtext", "id": "callout", "label": "Callout note below grid" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title", "default": "Nothing moves under braking" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{
    "name": "CS Card grid",
    "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
  }]
}
{% endschema %}
