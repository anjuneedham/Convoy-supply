{%- comment -%}
  ConvoySupply — specification table.
  Rule: no value goes in here that a supplier spec sheet does not support.
  Placeholders in the repo are marked [TBC]; none may ship.
{%- endcomment -%}
<section class="cs-section cs-section--light">
  <div class="cs-wrap cs-specs">
    {%- if section.settings.eyebrow != blank -%}<p class="cs-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="cs-h2">{{ section.settings.heading }}</h2>
    <div class="cs-specs__cols">
      <div>
        <table class="cs-table">
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'spec' -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.label }}</th>
                  <td>{{ block.settings.value }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
        {%- if section.settings.included != blank -%}
          <h3 class="cs-h3" style="margin-top:28px">What's included</h3>
          <div class="cs-body">{{ section.settings.included }}</div>
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', alt: section.settings.image_alt }}
        {%- endif -%}
        {%- if section.settings.fit_note != blank -%}
          <div class="cs-note" style="margin-top:20px">
            <h3 class="cs-h3">Fit</h3>
            <div class="cs-body">{{ section.settings.fit_note }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .cs-specs__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; margin-top: 28px; }
  .cs-specs__cols img { width: 100%; height: auto; border-radius: var(--cs-radius); }
  @media (max-width: 899px) { .cs-specs__cols { grid-template-columns: 1fr; gap: 28px; } }
</style>

{% schema %}
{
  "name": "CS Specs",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "richtext", "id": "included", "label": "What's included" },
    { "type": "image_picker", "id": "image", "label": "Dimension diagram or detail shot" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "richtext", "id": "fit_note", "label": "Fit note" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Deployed" },
        { "type": "text", "id": "value", "label": "Value", "default": "22\" H × 15\" W × 4\" D" }
      ]
    }
  ],
  "presets": [{ "name": "CS Specs", "blocks": [{ "type": "spec" }, { "type": "spec" }] }]
}
{% endschema %}
